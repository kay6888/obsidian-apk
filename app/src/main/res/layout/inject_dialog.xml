<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚫ INJECT CHAIN"
        android:textColor="#00FF41"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/target_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Target topic"
        android:textColor="#00FF41"
        android:textColorHint="#446666"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp"/>

    <Spinner
        android:id="@+id/style_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0A0A"
        android:textColor="#00FF41"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:id="@+id/inject_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?android:attr/progressBarStyleHorizontal"
        android:visibility="gone"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/inject_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textColor="#00FF41"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/execute_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ EXECUTE"
            android:background="#0AFF0A"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✕ CANCEL"
            android:background="#444444"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

    </LinearLayout>

</LinearLayout>
