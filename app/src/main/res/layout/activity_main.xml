<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚫ OBSIDIAN"
        android:textColor="#00FF41"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Local-only mode"
        android:textColor="#00FF41"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/scan_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="REFRESH"
            android:background="#1A1A1A"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/inject_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SAFETY"
            android:background="#1A1A1A"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/sync_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LOCAL"
            android:background="#1A1A1A"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/logs_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LOGS"
            android:background="#1A1A1A"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:layout_margin="4dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#00FF41"
        android:layout_marginVertical="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/porosity_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Saved Profiles: 0"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/nodes_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notes Logged: 0"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center"/>

        <TextView
            android:id="@+id/chains_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Review Flags: 0"
            android:textColor="#00FF41"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="end"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▌AUTOMATION REMOVED — LOCAL DATA ONLY ▌"
        android:textColor="#00FF41"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"/>

</LinearLayout>
